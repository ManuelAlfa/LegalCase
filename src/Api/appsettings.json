{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    // legalcase_app: rol de aplicación NO superusuario, sin bypass de RLS
    // (ver src/Infrastructure/Persistence/Sql/003_create_app_role.sql). Las
    // migraciones de EF Core NO usan esta connection string: la resuelve
    // AppDbContextFactory con el rol propietario `legalcase`.
    // Puerto 15432, no el 5432 estándar de Postgres — ver comentario en
    // docker-compose.yml (puerto 5432 del host bloqueado, causa no
    // identificada con certeza 2026-09-22, probable peculiaridad de WSL2).
    "Default": "Host=localhost;Port=15432;Database=legalcase;Username=legalcase_app;Password=legalcase_app_dev"
  },
  "Jwt": {
    "Issuer": "LegalCaseManagement.Api",
    "Audience": "LegalCaseManagement.Client",
    // SigningKey de DESARROLLO. Cambiar por un secreto fuerte gestionado
    // fuera del control de versiones (user-secrets, variable de entorno,
    // key vault, etc.) antes de cualquier despliegue real.
    "SigningKey": "RjgfqJQN7vblaHg+DSSCaPirykPiEwDD/UUXM93vt3k=",
    "AccessTokenMinutes": 60
  },
  "RabbitMq": {
    // El volumen rabbitmq_data ya existía con este usuario de una config
    // anterior; RABBITMQ_DEFAULT_USER/PASS del docker-compose.yml actual
    // solo aplican en la primera inicialización, así que no tienen efecto
    // aquí. Verificado con `docker exec legalcase-rabbitmq rabbitmqctl list_users`.
    "Host": "localhost",
    "Username": "legalcase",
    "Password": "legalcase_dev"
  },
  "DocumentStorage": {
    "Endpoint": "http://localhost:9000",
    "AccessKey": "legalcase",
    "SecretKey": "legalcase_dev",
    "BucketName": "documentos-adjuntos"
  }
}
