@* Listado completo de expedientes (ruta base de la tarea 6.2; la ficha de
   detalle con pestañas es la tarea 6.4). Reutiliza la misma tabla que el
   Panel principal para que ambas pantallas no diverjan. *@
@page "/expedientes"
@using LegalCaseManagement.Domain.Entities
@inject ExpedientesApiClient ExpedientesApiClient
@inject MateriasApiClient MateriasApiClient
@inject UsuariosApiClient UsuariosApiClient
@inject NavigationManager Navigation

<PageTitle>Expedientes — Compás</PageTitle>

<div class="cps-pagehead">
    <h1>Expedientes</h1>
</div>

@if (_cargando)
{
    <div class="cps-card"><p class="cps-vacio">Cargando expedientes…</p></div>
}
else if (_error is not null)
{
    <div class="cps-alert-error" role="alert">
        <svg class="icon" style="width:16px;height:16px"><use href="#i-x" /></svg>
        @_error
    </div>
}
else
{
    @if (ClienteFiltro is not null)
    {
        @* Viene del menú contextual de Clientes ("Ver todos"). *@
        <div class="cps-filtro-activo">
            Expedientes de <b>@NombreClienteFiltro</b>
            <button type="button" class="cps-btn cps-btn-text cps-btn-sm" @onclick="QuitarFiltroCliente">Quitar filtro</button>
        </div>
    }
    <TablaExpedientes Titulo="@(ClienteFiltro is null ? "Todos los expedientes" : "Expedientes del cliente")"
                      Expedientes="ExpedientesVisibles"
                      MateriasPorId="_materiasPorId"
                      AbogadosPorId="_abogadosPorId"
                      OnSeleccionar="AbrirExpediente"
                      OnNuevo="AbrirDialogoNuevo" />
}

@if (_dialogoAbierto)
{
    <DialogoNuevoExpediente OnCreado="AlCrearExpediente" OnCancelar="CerrarDialogo" />
}

@code {
    private bool _cargando = true;
    private string? _error;
    private List<Expediente> _expedientes = [];
    private Dictionary<Guid, Materia> _materiasPorId = [];
    private Dictionary<Guid, UsuarioResumen> _abogadosPorId = [];
    private bool _dialogoAbierto;

    /// <summary>Solo los expedientes de este cliente (?cliente=...).</summary>
    [SupplyParameterFromQuery(Name = "cliente")]
    public Guid? ClienteFiltro { get; set; }

    private List<Expediente> ExpedientesVisibles =>
        ClienteFiltro is { } id ? [.. _expedientes.Where(e => e.ClienteId == id)] : _expedientes;

    private string NombreClienteFiltro =>
        _expedientes.FirstOrDefault(e => e.ClienteId == ClienteFiltro)?.Cliente ?? "este cliente";

    private void QuitarFiltroCliente() => Navigation.NavigateTo("/expedientes");

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var expedientesTask = ExpedientesApiClient.ListarAsync();
            var materiasTask = MateriasApiClient.ListarAsync();
            var usuariosTask = UsuariosApiClient.ListarAsync();
            await Task.WhenAll(expedientesTask, materiasTask, usuariosTask);

            _expedientes = await expedientesTask;
            _materiasPorId = (await materiasTask).ToDictionary(m => m.Id);
            _abogadosPorId = (await usuariosTask).ToDictionary(u => u.Id);
        }
        catch (HttpRequestException)
        {
            _error = "No se pudieron cargar los expedientes. Comprueba que la Api esté en marcha y que la sesión siga siendo válida.";
        }
        finally
        {
            _cargando = false;
        }
    }

    private void AbrirExpediente(Guid id) => Navigation.NavigateTo($"/expedientes/{id}");

    private void AbrirDialogoNuevo() => _dialogoAbierto = true;

    private void CerrarDialogo() => _dialogoAbierto = false;

    // El expediente creado se añade a la lista en memoria en vez de recargar
    // todo: la Api ya lo ha devuelto completo, así que volver a pedir el
    // listado entero sería una llamada de más. Se coloca el primero porque
    // el listado va ordenado por fecha de apertura descendente.
    private void AlCrearExpediente(Expediente creado)
    {
        _dialogoAbierto = false;
        _expedientes.Insert(0, creado);
    }
}
