@* Clientes del despacho: listado y alta.

   El menú del mockup traía una sola entrada "Clientes y RGPD". Aquí van
   separadas a propósito: esta pantalla es trabajo diario (consultar y dar
   de alta), mientras que las acciones de RGPD —exportar los datos de un
   interesado, rectificarlos, solicitar su supresión— son excepcionales,
   se ejercen sobre un cliente concreto y están restringidas por rol. Son la
   tarea 6.8 del plan y necesitan antes los endpoints de la tarea C.1, que
   todavía no existen. *@
@page "/clientes"
@using LegalCaseManagement.Domain.Entities
@inject ClientesApiClient ClientesApiClient

<PageTitle>Clientes — Compás</PageTitle>

<div class="cps-pagehead">
    <h1>Clientes</h1>
</div>

@if (_cargando)
{
    <div class="cps-card"><p class="cps-vacio">Cargando clientes…</p></div>
}
else if (_error is not null)
{
    <div class="cps-alert-error" role="alert">
        <svg class="icon" style="width:16px;height:16px"><use href="#i-x" /></svg>
        @_error
    </div>
}
else
{
    <div class="cps-card">
        <div class="cps-list-toolbar">
            <h3 style="margin:0;flex:1">
                Clientes del despacho
                <span class="cps-count">@_clientes.Count en total</span>
            </h3>
            <button type="button" class="cps-btn cps-btn-filled cps-btn-sm" @onclick="AbrirDialogoNuevo">
                <svg class="icon" aria-hidden="true"><use href="#i-users" /></svg>
                Nuevo cliente
            </button>
        </div>

        @if (_clientes.Count == 0)
        {
            <p class="cps-vacio">Todavía no hay clientes registrados.</p>
        }
        else
        {
            <div class="cps-table-wrap">
                <table class="cps-table">
                    <thead>
                        <tr>
                            <th scope="col">Nombre</th>
                            <th scope="col">DNI / CIF</th>
                            <th scope="col">Correo electrónico</th>
                            <th scope="col">Teléfono</th>
                            <th scope="col">Canal preferido</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var cliente in _clientes)
                        {
                            <tr>
                                <td>@cliente.Nombre</td>
                                <td class="tabular">@cliente.DniCif</td>
                                <td>@cliente.Email</td>
                                <td class="tabular">@cliente.Telefono</td>
                                <td>@cliente.CanalPreferido</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
}

@if (_dialogoAbierto)
{
    <DialogoNuevoCliente OnCreado="AlCrearCliente" OnCancelar="CerrarDialogo" />
}

@code {
    private bool _cargando = true;
    private string? _error;
    private List<Cliente> _clientes = [];
    private bool _dialogoAbierto;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _clientes = [.. (await ClientesApiClient.ListarAsync()).OrderBy(c => c.Nombre)];
        }
        catch (HttpRequestException)
        {
            _error = "No se pudieron cargar los clientes. Comprueba que la Api esté en marcha y que la sesión siga siendo válida.";
        }
        finally
        {
            _cargando = false;
        }
    }

    private void AbrirDialogoNuevo() => _dialogoAbierto = true;

    private void CerrarDialogo() => _dialogoAbierto = false;

    // Se inserta manteniendo el orden alfabético del listado, en vez de
    // recargarlo entero: la Api ya ha devuelto el cliente completo.
    private void AlCrearCliente(Cliente creado)
    {
        _dialogoAbierto = false;
        _clientes.Add(creado);
        _clientes = [.. _clientes.OrderBy(c => c.Nombre)];
    }
}
