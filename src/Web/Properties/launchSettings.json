{
  "$schema": "https://json.schemastore.org/launchsettings.json",
  "profiles": {
    "http": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "launchBrowser": true,
      // Puerto 5100, el mismo que usa scripts/dev-arrancar.sh: así la
      // interfaz vive siempre en la misma URL se arranque como se arranque
      // (F5 desde el IDE, `dotnet run` o el script).
      "applicationUrl": "http://localhost:5100",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    }
  }
}
