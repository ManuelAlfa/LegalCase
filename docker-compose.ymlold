services:
  postgres:
    # pgvector/pgvector:pg16 = postgres:16 + extensión pgvector precompilada
    # (necesaria para Vector/FragmentoDocumento.Embedding). El postgres:16
    # estándar no la trae.
    image: pgvector/pgvector:pg16
    container_name: legalcase-postgres
    restart: unless-stopped
    environment:
      POSTGRES_DB: legalcase
      POSTGRES_USER: legalcase
      POSTGRES_PASSWORD: legalcase_dev
    ports:
      - "5432:5432"
    volumes:
      - postgres_data:/var/lib/postgresql/data

  rabbitmq:
    image: rabbitmq:3-management
    container_name: legalcase-rabbitmq
    restart: unless-stopped
    environment:
      RABBITMQ_DEFAULT_USER: legalcase
      RABBITMQ_DEFAULT_PASS: legalcase_dev
    ports:
      - "5672:5672"   # AMQP (lo usará la app)
      - "15672:15672" # panel de administración web (http://localhost:15672)
    volumes:
      - rabbitmq_data:/var/lib/rabbitmq

volumes:
  postgres_data:
  rabbitmq_data:
